# 目标 Saleor GraphQL API 端点
SALEOR_API_ENDPOINT=https://ntms-saleor.kubernetes.nucleartattoosupply.com/graphql/

# Saleor App 或管理 Token (具有 MANAGE_PRODUCTS, MANAGE_PRODUCT_TYPES_AND_ATTRIBUTES 权限)
SALEOR_APP_TOKEN=

# 默认销售渠道与基准货币
SALEOR_CHANNEL=default-channel
SALEOR_CURRENCY=USD

# 默认发货仓库 ID (用于初始库存上架)
SALEOR_WAREHOUSE_ID=

# 服务监听端口
PORT=3003
